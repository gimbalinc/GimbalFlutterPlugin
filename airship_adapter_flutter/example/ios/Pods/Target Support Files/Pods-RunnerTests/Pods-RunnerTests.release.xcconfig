CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Airship" "${PODS_CONFIGURATION_BUILD_DIR}/GimbalAirshipAdapter" "${PODS_CONFIGURATION_BUILD_DIR}/airship_adapter_flutter" "${PODS_CONFIGURATION_BUILD_DIR}/integration_test" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple" "${PODS_ROOT}/GimbalXCFramework/XCFrameworks" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GimbalXCFramework" "$(PODS_ROOT)/Gimbal/Frameworks"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/Airship/AirshipKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GimbalAirshipAdapter/GimbalAirshipAdapter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/airship_adapter_flutter/airship_adapter_flutter.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/integration_test/integration_test.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple/permission_handler_apple.framework/Headers"
OTHER_LDFLAGS = $(inherited) -l"sqlite3" -l"z" -framework "AirshipKit" -framework "CFNetwork" -framework "CoreData" -framework "CoreGraphics" -framework "CoreLocation" -framework "CoreTelephony" -framework "Foundation" -framework "Gimbal" -framework "GimbalAirshipAdapter" -framework "MobileCoreServices" -framework "Security" -framework "StoreKit" -framework "SystemConfiguration" -framework "UIKit" -framework "UserNotifications" -framework "WebKit" -framework "airship_adapter_flutter" -framework "integration_test"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
